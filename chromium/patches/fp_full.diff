+std::optional<base::DictValue> GPU::FingerprintWebGPU() const {
+  std::string fingerprint;
+  ExecutionContext* context = GetExecutionContext();
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      if (WebLocalFrameImpl* web_frame = WebLocalFrameImpl::FromFrame(frame);
+          web_frame && web_frame->ViewImpl()) {
+        fingerprint =
+            web_frame->ViewImpl()->GetRendererPreferences().fingerprint;
+      }
+    }
+  } else if (auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    fingerprint = worker->Fingerprint().Utf8();
+  }
+  if (fingerprint.empty())
+    return std::nullopt;
+  std::optional<base::Value> root =
+      base::JSONReader::Read(fingerprint, base::JSON_PARSE_RFC);
+  if (!root || !root->is_dict())
+    return std::nullopt;
+  const base::DictValue* webgpu = root->GetDict().FindDict("webGPU");
+  if (!webgpu)
+    return std::nullopt;
+  return webgpu->Clone();
+}
