+std::optional<ScriptValue>
+WebGLRenderingContextBase::FingerprintParameter(ScriptState* script_state,
+                                                GLenum pname) {
+  const char* profile_key =
+      IsWebGL2() ? "webgl2Parameters" : "webglParameters";
+  std::string fp = FpJsonForCtx(Host()->GetTopExecutionContext());
+  if (fp.empty())
+    return std::nullopt;
+  std::optional<base::Value> root =
+      base::JSONReader::Read(fp, base::JSON_PARSE_RFC);
+  if (!root || !root->is_dict())
+    return std::nullopt;
+  const base::DictValue* parameters =
+      root->GetDict().FindDict(profile_key);
+  if (!parameters)
+    return std::nullopt;
+  const base::DictValue* entry =
+      parameters->FindDict(base::NumberToString(pname));
+  if (!entry)
+    return std::nullopt;
+  const std::string* type = entry->FindString("type");
+  const base::Value* value = entry->Find("value");
+  if (!type || !value)
+    return std::nullopt;
+
+  if (*type == "bool") {
+    if (std::optional<bool> v = value->GetIfBool())
+      return WebGLAny(script_state, *v);
+  } else if (*type == "int") {
+    if (std::optional<int> v = value->GetIfInt())
+      return WebGLAny(script_state, *v);
+    if (std::optional<double> v = value->GetIfDouble())
+      return WebGLAny(script_state, static_cast<int>(*v));
+  } else if (*type == "uint") {
+    if (std::optional<int> v = value->GetIfInt(); v && *v >= 0)
+      return WebGLAny(script_state, static_cast<unsigned>(*v));
+  } else if (*type == "float") {
+    if (std::optional<double> v = value->GetIfDouble())
+      return WebGLAny(script_state, static_cast<float>(*v));
+    if (std::optional<int> v = value->GetIfInt())
+      return WebGLAny(script_state, static_cast<float>(*v));
+  } else if (*type == "string") {
+    if (const std::string* v = value->GetIfString())
+      return WebGLAny(
+          script_state, String::FromUtf8(std::string_view(*v)));
+  } else if (*type == "int32" || *type == "float32") {
+    const base::ListValue* list = value->GetIfList();
+    if (!list)
+      return std::nullopt;
+    if (*type == "int32") {
+      Vector<int> values;
+      for (const base::Value& item : *list) {
+        if (std::optional<int> v = item.GetIfInt()) {
+          values.push_back(*v);
+        } else {
+          return std::nullopt;
+        }
+      }
+      return WebGLAny(script_state, DOMInt32Array::Create(values));
+    }
+    Vector<float> values;
+    for (const base::Value& item : *list) {
+      if (std::optional<double> double_value = item.GetIfDouble()) {
+        values.push_back(static_cast<float>(*double_value));
+      } else if (std::optional<int> int_value = item.GetIfInt()) {
+        values.push_back(static_cast<float>(*int_value));
+      } else {
+        return std::nullopt;
+      }
+    }
+    return WebGLAny(script_state, DOMFloat32Array::Create(values));
+  }
+  return std::nullopt;
+}
