+  std::string utf8 = src.Utf8();
+  std::string out;
+  std::string_view rest(utf8);
+  while (!rest.empty()) {
+    size_t comma = rest.find(',');
+    std::string_view tok = rest.substr(0, comma);
+    rest = (comma == std::string_view::npos) ? std::string_view()
+                                             : rest.substr(comma + 1);
+    tok = tok.substr(0, tok.find(';'));
+    while (!tok.empty() && (tok.front() == ' ' || tok.front() == '\t'))
+      tok.remove_prefix(1);
+    while (!tok.empty() && (tok.back() == ' ' || tok.back() == '\t'))
+      tok.remove_suffix(1);
+    if (tok.empty())
+      continue;
+    if (!out.empty())
+      out += ',';
+    out.append(tok);
+  }
+  return String::FromUtf8(std::string_view(out));
