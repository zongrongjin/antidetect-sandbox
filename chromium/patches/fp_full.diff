+// canvas 读回面 noise：seed 驱动、XOR 每像素 R 低位（幂等：每次 getImageData 新分配像素，一次 XOR 一致）
+void ApplyCanvasNoise(ImageData* image_data, ExecutionContext* ec) {
+  if (!image_data)
+    return;
+  SkPixmap pm = image_data->GetSkPixmap();
+  auto* px = static_cast<uint8_t*>(pm.writable_addr());
+  if (!px)
+    return;
+  size_t n = pm.computeByteSize();
+  // //BROWSER_FINGERPRINT: (1) fixed-replay canvasDataReplay(按调用序返回真机 RGBA)
+  {
+    std::string fp_j = FpReadbackJson(ec);
+    if (!fp_j.empty()) {
+      if (std::optional<base::Value> fp_v =
+              base::JSONReader::Read(fp_j, base::JSON_PARSE_RFC)) {
+        if (fp_v->is_dict()) {
+          if (const base::ListValue* rep =
+                  fp_v->GetDict().FindList("canvasDataReplay")) {
+            if (!rep->empty()) {
+              static thread_local size_t fp_cd_seq = 0;
+              size_t idx = (fp_cd_seq++) % rep->size();
+              if (const std::string* b64 = (*rep)[idx].GetIfString()) {
+                std::string bytes;
+                if (base::Base64Decode(*b64, &bytes)) {
+                  size_t m = bytes.size() < n ? bytes.size() : n;
+                  for (size_t i = 0; i < m; i++)
+                    UNSAFE_BUFFERS(px[i] = static_cast<uint8_t>(bytes[i]));
