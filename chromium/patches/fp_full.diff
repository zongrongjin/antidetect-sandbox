+// //BROWSER_FINGERPRINT: raw request/response headers in real wire order
+// (name/value list; parallels GetRawHeaders' map but preserves order + dups).
+std::unique_ptr<protocol::Array<protocol::Network::HeaderEntry>>
+GetRawHeadersList(
+    const std::vector<network::mojom::HttpRawHeaderPairPtr>& headers) {
+  auto list =
+      std::make_unique<protocol::Array<protocol::Network::HeaderEntry>>();
+  for (const auto& header : headers) {
+    std::string header_value;
+    if (!base::ConvertToUtf8AndNormalize(header->value, base::kCodepageLatin1,
+                                         &header_value)) {
+      header_value = header->value;
+    }
+    list->push_back(protocol::Network::HeaderEntry::Create()
+                        .SetName(header->key)
+                        .SetValue(header_value)
+                        .Build());
+  }
+  return list;
+}
