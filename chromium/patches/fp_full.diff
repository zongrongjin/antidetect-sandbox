+// //BROWSER_FINGERPRINT: request headers in real wire order (name/value list;
+// mirrors BuildRequestHeaders' iteration + referrer, but order-preserving).
+std::unique_ptr<protocol::Array<protocol::Network::HeaderEntry>>
+BuildOrderedRequestHeaders(const net::HttpRequestHeaders& headers,
+                           const GURL& referrer) {
+  auto list =
+      std::make_unique<protocol::Array<protocol::Network::HeaderEntry>>();
+  for (net::HttpRequestHeaders::Iterator it(headers); it.GetNext();) {
+    list->push_back(protocol::Network::HeaderEntry::Create()
+                        .SetName(it.name())
+                        .SetValue(it.value())
+                        .Build());
+  }
+  if (!referrer.is_empty()) {
+    list->push_back(protocol::Network::HeaderEntry::Create()
+                        .SetName(net::HttpRequestHeaders::kReferer)
+                        .SetValue(referrer.spec())
+                        .Build());
+  }
+  return list;
+}
