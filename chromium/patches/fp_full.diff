+  bool fp_trivial = true;
+  for (size_t ti = 4; ti + 4 <= n; ti += 4) {
+    if (UNSAFE_BUFFERS(px[ti] != px[0] || px[ti + 1] != px[1] ||
+                       px[ti + 2] != px[2] || px[ti + 3] != px[3])) {
+      fp_trivial = false;
+      break;
+    }
+  }
+  if (fp_trivial)
+    return;
+  for (size_t i = 0; i + 4 <= n; i += 4) {
+    uint32_t h = (static_cast<uint32_t>(seed) + static_cast<uint32_t>(i)) * 2654435761u;
+    h ^= h >> 15; h *= 0x85ebca6bu; h ^= h >> 13;  // murmur 混合：扰动位依赖整个 seed
+    UNSAFE_BUFFERS(px[i] ^= static_cast<uint8_t>(h & 1u));
+  }
+}
