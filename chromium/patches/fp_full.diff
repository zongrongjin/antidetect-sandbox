+// //BROWSER_FINGERPRINT: 取该执行上下文(window 或 worker)的 fingerprint JSON 串。
+std::string FpJsonForCtx(ExecutionContext* ec) {
+  if (auto* window = DynamicTo<LocalDOMWindow>(ec)) {
+    LocalFrame* frame = window->GetFrame();
+    if (!frame)
+      return std::string();
+    WebLocalFrameImpl* wf = WebLocalFrameImpl::FromFrame(frame);
+    if (!wf || !wf->ViewImpl())
+      return std::string();
+    return wf->ViewImpl()->GetRendererPreferences().fingerprint;
+  }
+  if (auto* wgs = DynamicTo<WorkerGlobalScope>(ec))
+    return wgs->Fingerprint().Utf8();
+  return std::string();
+}
+// //BROWSER_FINGERPRINT: 从 ExecutionContext 取 fingerprint JSON 的字符串键。
+String FingerprintWebGLString(ExecutionContext* ec, const char* key) {
+  std::string fp = FpJsonForCtx(ec);  // //BROWSER_FINGERPRINT: window+worker
+  if (fp.empty())
+    return String();
+  std::optional<base::Value> v = base::JSONReader::Read(fp, base::JSON_PARSE_RFC);
+  if (!v || !v->is_dict())
+    return String();
+  if (const std::string* str = v->GetDict().FindString(key))
+    return String::FromUtf8(std::string_view(*str));
+  return String();
+}
+
+// //BROWSER_FINGERPRINT: 从 fingerprint JSON 取字符串数组键（如 webglExtensions）。
+Vector<String> FingerprintWebGLList(ExecutionContext* ec, const char* key) {
+  Vector<String> out;
+  std::string fp = FpJsonForCtx(ec);  // //BROWSER_FINGERPRINT: window+worker
+  if (fp.empty())
+    return out;
+  std::optional<base::Value> v = base::JSONReader::Read(fp, base::JSON_PARSE_RFC);
+  if (!v || !v->is_dict())
+    return out;
+  if (const base::ListValue* list = v->GetDict().FindList(key)) {
+    for (const base::Value& it : *list) {
+      if (const std::string* s = it.GetIfString())
+        out.push_back(String::FromUtf8(std::string_view(*s)));
+    }
+  }
+  return out;
+}
