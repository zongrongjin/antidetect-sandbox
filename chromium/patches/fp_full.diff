+std::optional<std::tuple<bool, bool, bool>>
+GetFingerprintDecodingInfo(ScriptState* script_state,
+                           const MediaDecodingConfiguration* config) {
+  auto* window =
+      DynamicTo<LocalDOMWindow>(ExecutionContext::From(script_state));
+  if (!window || !window->GetFrame()) {
+    return std::nullopt;
+  }
+  WebLocalFrameImpl* web_frame =
+      WebLocalFrameImpl::FromFrame(window->GetFrame());
+  if (!web_frame || !web_frame->ViewImpl()) {
+    return std::nullopt;
+  }
+  const std::string& fingerprint =
+      web_frame->ViewImpl()->GetRendererPreferences().fingerprint;
+  std::optional<base::Value> root =
+      fingerprint.empty()
+          ? std::nullopt
+          : base::JSONReader::Read(fingerprint, base::JSON_PARSE_RFC);
+  const base::DictValue* media_codecs =
+      root && root->is_dict()
+          ? root->GetDict().FindDict("mediaCodecs")
+          : nullptr;
+  const base::DictValue* matrix =
+      media_codecs ? media_codecs->FindDict("decodingInfo") : nullptr;
+  if (!matrix || config->hasKeySystemConfiguration()) {
+    return std::nullopt;
+  }
+
+  bool supported = true;
+  bool smooth = true;
+  bool power_efficient = true;
+  auto merge = [&](const String& content_type) {
+    const std::string key = content_type.Utf8();
+    const base::DictValue* entry = matrix->FindDict(key);
+    if (!entry)
+      return false;
+    std::optional<bool> entry_supported = entry->FindBool("supported");
+    std::optional<bool> entry_smooth = entry->FindBool("smooth");
+    std::optional<bool> entry_power = entry->FindBool("powerEfficient");
+    if (!entry_supported || !entry_smooth || !entry_power)
+      return false;
+    supported &= *entry_supported;
+    smooth &= *entry_smooth;
+    power_efficient &= *entry_power;
+    return true;
+  };
+  if (config->hasAudio() && !merge(config->audio()->contentType()))
+    return std::nullopt;
+  if (config->hasVideo() && !merge(config->video()->contentType()))
+    return std::nullopt;
+  return std::tuple(supported, smooth, power_efficient);
+}
