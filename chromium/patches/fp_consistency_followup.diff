+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    LocalFrame* frame = window->GetFrame();
+    WebLocalFrameImpl* web_frame =
+        frame ? WebLocalFrameImpl::FromFrame(frame) : nullptr;
+    if (web_frame && web_frame->ViewImpl()) {
+      fingerprint =
+          web_frame->ViewImpl()->GetRendererPreferences().fingerprint;
+    }
+  } else if (auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    fingerprint = worker->Fingerprint().Utf8();
+  }
+  if (fingerprint.empty()) return std::nullopt;
+  std::optional<base::Value> profile =
+      base::JSONReader::Read(fingerprint, base::JSON_PARSE_RFC);
+  if (!profile || !profile->is_dict()) return std::nullopt;
+  const base::DictValue* media_codecs =
+      profile->GetDict().FindDict("mediaCodecs");
+  const base::ListValue* supported =
+      media_codecs ? media_codecs->FindList("mediaSource") : nullptr;
+  if (!supported) return std::nullopt;
+  const std::string requested = type.Utf8();
+  for (const base::Value& entry : *supported) {
+    if (entry.is_string() && entry.GetString() == requested) return true;
+  }
+  return false;
+}
