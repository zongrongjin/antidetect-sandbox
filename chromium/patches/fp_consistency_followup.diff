+  bool smooth = true;
+  bool power_efficient = true;
+  auto merge = [&](const String& content_type) {
+    const std::string key = content_type.Utf8();
+    const base::DictValue* entry = matrix->FindDict(key);
+    if (!entry)
+      return false;
+    std::optional<bool> entry_supported = entry->FindBool("supported");
+    std::optional<bool> entry_smooth = entry->FindBool("smooth");
+    std::optional<bool> entry_power = entry->FindBool("powerEfficient");
+    if (!entry_supported || !entry_smooth || !entry_power)
+      return false;
+    supported &= *entry_supported;
+    smooth &= *entry_smooth;
+    power_efficient &= *entry_power;
+    return true;
+  };
+  if (config->hasAudio() && !merge(config->audio()->contentType()))
+    return std::nullopt;
+  if (config->hasVideo() && !merge(config->video()->contentType()))
+    return std::nullopt;
+  return std::tuple(supported, smooth, power_efficient);
+}
