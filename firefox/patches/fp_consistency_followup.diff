+static bool MaybeResolveFingerprintDecodingInfo(
+    nsIGlobalObject* aParent,
+    const MediaDecodingConfiguration& aConfiguration,
+    Promise* aPromise) {
+  if (aConfiguration.mKeySystemConfiguration.WasPassed()) {
+    return false;
+  }
+  nsAutoString fingerprint;
+  if (auto* window = aParent->GetAsInnerWindow()) {
+    if (Document* document = window->GetExtantDoc()) {
+      if (BrowsingContext* context = document->GetBrowsingContext()) {
+        fingerprint = context->Top()->GetFingerprintProfile();
+      }
+    }
+  } else if (WorkerPrivate* worker = GetCurrentThreadWorkerPrivate()) {
+    fingerprint = worker->GetFingerprintProfile();
+  }
+  if (fingerprint.IsEmpty()) {
+    return false;
+  }
+
+  bool configured = false;
+  bool supported = true;
+  bool smooth = true;
+  bool powerEfficient = true;
+  {
+    AutoJSAPI jsapi;
+    if (!jsapi.Init(aParent)) {
+      return false;
+    }
+    JSContext* cx = jsapi.cx();
+    JS::Rooted<JS::Value> root(cx);
+    if (JS_ParseJSON(cx, fingerprint.BeginReading(), fingerprint.Length(),
+                     &root) &&
+        root.isObject()) {
+      JS::Rooted<JSObject*> rootObject(cx, &root.toObject());
+      JS::Rooted<JS::Value> mediaCodecs(cx);
+      JS::Rooted<JS::Value> decodingInfo(cx);
+      if (JS_GetProperty(cx, rootObject, "mediaCodecs", &mediaCodecs) &&
+          mediaCodecs.isObject()) {
+        JS::Rooted<JSObject*> mediaCodecsObject(
+            cx, &mediaCodecs.toObject());
+        if (JS_GetProperty(cx, mediaCodecsObject, "decodingInfo",
+                           &decodingInfo) &&
+            decodingInfo.isObject()) {
+          JS::Rooted<JSObject*> matrix(cx, &decodingInfo.toObject());
+          auto merge = [&](const nsAString& contentType) {
+            NS_ConvertUTF16toUTF8 key(contentType);
+            JS::Rooted<JS::Value> entry(cx);
+            if (!JS_GetProperty(cx, matrix, key.get(), &entry) ||
+                !entry.isObject()) {
+              return false;
+            }
+            JS::Rooted<JSObject*> object(cx, &entry.toObject());
+            JS::Rooted<JS::Value> supportedValue(cx);
+            JS::Rooted<JS::Value> smoothValue(cx);
+            JS::Rooted<JS::Value> powerValue(cx);
+            if (!JS_GetProperty(cx, object, "supported", &supportedValue) ||
+                !supportedValue.isBoolean() ||
+                !JS_GetProperty(cx, object, "smooth", &smoothValue) ||
+                !smoothValue.isBoolean() ||
+                !JS_GetProperty(cx, object, "powerEfficient", &powerValue) ||
+                !powerValue.isBoolean()) {
+              return false;
+            }
+            supported &= supportedValue.toBoolean();
+            smooth &= smoothValue.toBoolean();
+            powerEfficient &= powerValue.toBoolean();
+            return true;
+          };
+          configured =
+              (!aConfiguration.mAudio.WasPassed() ||
+               merge(aConfiguration.mAudio.Value().mContentType)) &&
+              (!aConfiguration.mVideo.WasPassed() ||
+               merge(aConfiguration.mVideo.Value().mContentType));
+        }
+      }
+    }
+    JS_ClearPendingException(cx);
+  }
+  if (!configured) {
+    return false;
+  }
+  MediaCapabilitiesDecodingInfo info;
+  info.mSupported = supported;
+  info.mSmooth = smooth;
+  info.mPowerEfficient = powerEfficient;
+  aPromise->MaybeResolve(std::move(info));
+  return true;
+}
