+static bool FingerprintCssMedia(const Document* aDocument, const char* aKey,
+                                nsAString& aValue) {
+  if (!aDocument) return false;
+  dom::BrowsingContext* context = aDocument->GetBrowsingContext();
+  if (!context) return false;
+  const nsString profile = context->Top()->GetFingerprintProfile();
+  if (profile.IsEmpty()) return false;
+  nsAutoString pattern;
+  pattern.Append(char16_t('"'));
+  pattern.AppendASCII(aKey);
+  pattern.Append(char16_t('"'));
+  pattern.Append(char16_t(':'));
+  int32_t position = profile.Find(pattern);
+  if (position < 0) return false;
+  position += pattern.Length();
+  while (position < static_cast<int32_t>(profile.Length()) &&
+         (profile[position] == char16_t(' ') ||
+          profile[position] == char16_t('\t'))) {
+    ++position;
+  }
+  if (position >= static_cast<int32_t>(profile.Length()) ||
+      profile[position] != char16_t('"')) {
+    return false;
+  }
+  int32_t end = profile.FindChar(char16_t('"'), position + 1);
+  if (end < 0) return false;
+  aValue.Assign(Substring(profile, position + 1, end - position - 1));
+  return true;
+}
