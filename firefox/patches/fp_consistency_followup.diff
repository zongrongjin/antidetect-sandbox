+void OffscreenCanvas::CopyFingerprintProfile(nsAString& aProfile) const {
+  aProfile.Truncate();
+  if (NS_IsMainThread()) {
+    nsCOMPtr<nsPIDOMWindowInner> window =
+        do_QueryInterface(GetRelevantGlobal());
+    if (Document* document = window ? window->GetExtantDoc() : nullptr) {
+      if (BrowsingContext* context = document->GetBrowsingContext()) {
+        aProfile.Assign(context->Top()->GetFingerprintProfile());
+      }
+    }
+    return;
+  }
+  if (WorkerPrivate* worker = GetCurrentThreadWorkerPrivate()) {
+    aProfile.Assign(worker->GetFingerprintProfile());
