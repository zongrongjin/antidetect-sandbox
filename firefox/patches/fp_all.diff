+// BROWSER_FINGERPRINT: resolve a per-context font alias before the platform
+// font lookup. This is in the actual font selection path, so Canvas text
+// metrics, DOM layout and Range geometry all observe the same selected font.
+static bool FpLookupFontAlias(FontVisibilityProvider* aProvider,
+                              const nsACString& aName,
+                              nsACString& aAlias) {
+  if (!aProvider) {
+    return false;
+  }
+  nsAutoString profile16;
+  aProvider->CopyFingerprintProfile(profile16);
+  if (profile16.IsEmpty()) {
+    return false;
+  }
+  NS_ConvertUTF16toUTF8 profile(profile16);
+  int32_t objectKey = profile.Find("\"fontAliases\"");
+  if (objectKey < 0) {
+    return false;
+  }
+  int32_t objectStart = profile.FindChar('{', objectKey);
+  int32_t objectEnd =
+      objectStart < 0 ? -1 : profile.FindChar('}', objectStart + 1);
+  if (objectStart < 0 || objectEnd < 0) {
+    return false;
+  }
+
+  nsAutoCString key("\"");
+  key.Append(aName);
+  key.Append('"');
+  nsDependentCSubstring aliases(
+      profile, objectStart + 1, objectEnd - objectStart - 1);
+  int32_t keyOffset = aliases.Find(key);
+  if (keyOffset < 0) {
+    return false;
+  }
+  int32_t keyPos = objectStart + 1 + keyOffset;
+  int32_t colon = profile.FindChar(':', keyPos + key.Length());
+  if (colon < 0 || colon >= objectEnd) {
+    return false;
+  }
+  int32_t valueStart = profile.FindChar('"', colon + 1);
+  if (valueStart < 0 || valueStart >= objectEnd) {
+    return false;
+  }
+  int32_t valueEnd = profile.FindChar('"', valueStart + 1);
+  if (valueEnd <= valueStart || valueEnd > objectEnd) {
+    return false;
+  }
+  aAlias.Assign(Substring(profile, valueStart + 1,
+                          valueEnd - valueStart - 1));
+  return !aAlias.IsEmpty();
+}
