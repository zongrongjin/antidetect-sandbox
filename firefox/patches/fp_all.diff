+  }
+  if (position >= static_cast<int32_t>(profile.Length()) ||
+      profile[position] != char16_t('"')) {
+    return false;
+  }
+  int32_t end = profile.FindChar(char16_t('"'), position + 1);
+  if (end < 0) return false;
+  aValue.Assign(Substring(profile, position + 1, end - position - 1));
+  return true;
+}
