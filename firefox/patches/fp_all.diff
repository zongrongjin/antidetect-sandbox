+    while (e < n && d[e] >= char16_t('0') && d[e] <= char16_t('9')) ++e;
+    if (e == ds) continue;
+    nsAutoString num(Substring(j, s, e - s));
+    nsresult rv;
+    int32_t v = num.ToInteger(&rv);
+    if (NS_FAILED(rv)) continue;
+    out = v;
+    return true;
+  }
+  return false;
