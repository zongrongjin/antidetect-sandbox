+  const char16_t* d = aJson.BeginReading(); const char16_t* p = pat.BeginReading();
+  uint32_t n = aJson.Length(), pl = pat.Length();
+  for (uint32_t i = 0; i + pl <= n; ++i) {
+    bool m = true;
+    for (uint32_t j = 0; j < pl; ++j) { if (d[i + j] != p[j]) { m = false; break; } }
+    if (!m) continue;
+    uint32_t k = i + pl;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t(':')) continue;
+    ++k;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t('"')) continue;
+    uint32_t s = k + 1, e = s; while (e < n && d[e] != char16_t('"')) ++e;
+    aOut = Substring(aJson, s, e - s); return true;
+  }
+  return false;
+}
+// BROWSER_FINGERPRINT: 从画像 JSON 里取一个字符串数组键（值内无转义/无嵌套）
+static bool FpwExtractStrArray(const nsAString& aJson, const char* aKey,
+                               nsTArray<nsString>& aOut) {
+  nsAutoString pat;
+  pat.Append(char16_t('"'));
+  pat.AppendASCII(aKey);
+  pat.Append(char16_t('"'));
+  const char16_t* d = aJson.BeginReading();
+  const char16_t* p = pat.BeginReading();
+  uint32_t n = aJson.Length(), pl = pat.Length();
+  for (uint32_t i = 0; i + pl <= n; ++i) {
+    bool m = true;
+    for (uint32_t j = 0; j < pl; ++j) {
+      if (d[i + j] != p[j]) { m = false; break; }
+    }
+    if (!m) continue;
+    uint32_t k = i + pl;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t(':')) continue;
+    ++k;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t('[')) continue;
+    ++k;
+    while (k < n && d[k] != char16_t(']')) {
+      if (d[k] == char16_t('"')) {
+        uint32_t sidx = k + 1, e = sidx;
+        while (e < n && d[e] != char16_t('"')) ++e;
+        aOut.AppendElement(nsString(Substring(aJson, sidx, e - sidx)));
+        k = (e < n) ? e + 1 : e;
+      } else {
+        ++k;
+      }
+    }
+    return true;
+  }
+  return false;
+}
