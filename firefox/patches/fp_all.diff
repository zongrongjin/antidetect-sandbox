+// //BROWSER_FINGERPRINT: 读回面 noise/replay helpers
+namespace {
+static nsString FpRbProfileHc(mozilla::dom::Document* aDoc) {
+  if (!aDoc) return nsString();
+  mozilla::dom::BrowsingContext* bc = aDoc->GetBrowsingContext();
+  if (!bc) return nsString();
+  mozilla::dom::BrowsingContext* top = bc->Top();
+  return top ? top->GetFingerprintProfile() : nsString();
+}
+static bool FpRbExtractStrArrayHc(const nsAString& j, const char* key, nsTArray<nsString>& out) {
+  nsAutoString pat; pat.Append(char16_t('"')); pat.AppendASCII(key); pat.Append(char16_t('"'));
+  const char16_t* d = j.BeginReading(); const char16_t* p = pat.BeginReading();
+  uint32_t n = j.Length(), pl = pat.Length();
+  for (uint32_t i = 0; i + pl <= n; ++i) {
+    bool m = true; for (uint32_t k = 0; k < pl; ++k) { if (d[i + k] != p[k]) { m = false; break; } } if (!m) continue;
+    uint32_t k = i + pl; while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t(':')) continue; ++k;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t('[')) continue; ++k;
+    while (k < n && d[k] != char16_t(']')) {
+      if (d[k] == char16_t('"')) { uint32_t s = k + 1, e = s; while (e < n && d[e] != char16_t('"')) ++e; out.AppendElement(nsString(Substring(j, s, e - s))); k = (e < n) ? e + 1 : e; }
+      else { ++k; }
+    }
+    return true;
+  }
+  return false;
+}
+static bool FpRbReplayStringHc(const nsAString& j, const char* key, nsAString& out, uint32_t& seq) {
+  nsTArray<nsString> rep; if (!FpRbExtractStrArrayHc(j, key, rep) || rep.IsEmpty()) return false;
+  size_t idx = (seq++) % rep.Length(); out = rep[idx]; return true;
+}
+}  // namespace (BROWSER_FINGERPRINT)
