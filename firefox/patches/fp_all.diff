+//BROWSER_FINGERPRINT
+/**
+ * Set the fingerprint profile override to the top-level browsing context.
+ * Writes context.customFingerprint (synced BC field), and, if the profile JSON
+ * carries timezone/locale keys, also drives the existing tz/locale BC overrides
+ * so timezone-/language-dependent APIs stay consistent with the profile.
+ *
+ * @param {object} options
+ * @param {BrowsingContext} options.context
+ * @param {string} options.value  Fingerprint profile as a JSON string ("" resets).
+ */
+export const setFingerprintProfileForBrowsingContext = options => {
+  const { context, value } = options;
+  const contextId = lazy.NavigableManager.getIdForBrowsingContext(context);
+
+  try {
+    context.customFingerprint = value;
+
+    let tz = "";
+    let loc = "";
+    let ua = "";
+    let dpr = 0;
+    let touch = null;
+    if (value) {
+      try {
+        const obj = JSON.parse(value);
+        if (obj && typeof obj.timezone === "string") {
+          tz = obj.timezone;
+        }
+        if (obj && typeof obj.locale === "string") {
+          loc = obj.locale;
+        }
+        if (obj && typeof obj.userAgent === "string") {
+          ua = obj.userAgent;
+        }
+        // //BROWSER_FINGERPRINT: 移动端画像——devicePixelRatio 与触摸能力。
+        // 两者都走原生 BC 覆盖(RDM 同款)，故 JS 侧与 CSS 侧同步生效：
+        //  · overrideDPPX      -> window.devicePixelRatio + CSS (resolution)/(-moz-device-pixel-ratio)
+        //  · touchEventsOverride -> TouchEvent/ontouchstart 门限 + CSS (pointer:coarse)/(hover:none)
+        // 仅改 JS getter 而不动 layout 层会在媒体查询上露馅，故必须用这两个字段。
+        if (obj && typeof obj.dpr === "number" && obj.dpr > 0) {
+          dpr = obj.dpr;
+        }
+        if (obj && typeof obj.touch === "boolean") {
+          touch = obj.touch;
+        }
+      } catch (e) {
+        lazy.logger.warn(
+          `Failed to parse fingerprint profile for context ${contextId}: ${e.message}`
+        );
+      }
+    }
+    // Keep existing tz/locale behaviour: set (or reset to "") the BC overrides.
+    try {
+      context.timezoneOverride = tz;
+    } catch (e) {
+      lazy.logger.warn(`[${contextId}] fingerprint tz override failed: ${e.message}`);
+    }
+    try {
+      context.languageOverride = loc;
+    } catch (e) {
+      lazy.logger.warn(`[${contextId}] fingerprint locale override failed: ${e.message}`);
+    }
+    // //BROWSER_FINGERPRINT: 驱动原生 UserAgentOverride(customUserAgent)——Gecko 网络层
+    // nsHttpChannel::SetDocshellUserAgentOverride 与 navigator.userAgent 都原生读它，
+    // 使 HTTP 请求头 UA 与画像一致（导航+子资源，跨进程随 synced BC 字段同步）。
+    try {
+      context.customUserAgent = ua;
+    } catch (e) {
+      lazy.logger.warn(`[${contextId}] fingerprint UA override failed: ${e.message}`);
+    }
+
+    // devicePixelRatio：0 表示不覆盖(恢复原生行为)。
+    try {
+      context.overrideDPPX = dpr;
+    } catch (e) {
+      lazy.logger.warn(`[${contextId}] fingerprint dpr override failed: ${e.message}`);
+    }
+
+    // 触摸：与画像里的 maxTouchPoints 必须一致——报了触点却没有 TouchEvent
+    // (或反之)是一致性检测的第一道题。null 表示不覆盖。
+    try {
+      if (touch === null) {
+        context.touchEventsOverride = "none";
+      } else {
+        context.touchEventsOverride = touch ? "enabled" : "disabled";
+      }
+    } catch (e) {
+      lazy.logger.warn(`[${contextId}] fingerprint touch override failed: ${e.message}`);
+    }
+
+    lazy.logger.trace(`[${contextId}] Updated fingerprint profile override`);
+  } catch (e) {
+    lazy.logger.warn(
+      `Failed to override fingerprint for context with id: ${contextId} (${e.message})`
+    );
+  }
+};
+
 export const emulation = EmulationModule;
