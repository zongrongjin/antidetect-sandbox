+// BROWSER_FINGERPRINT: minimal int extractor over the profile JSON.
+static bool FpMfExtractInt(const nsAString& aJson, const char* aKey,
+                           int32_t& aOut) {
+  nsAutoString pat;
+  pat.Append(char16_t('"'));
+  pat.AppendASCII(aKey);
+  pat.Append(char16_t('"'));
+  const char16_t* d = aJson.BeginReading();
+  const char16_t* p = pat.BeginReading();
+  uint32_t n = aJson.Length(), pl = pat.Length();
+  for (uint32_t i = 0; i + pl <= n; ++i) {
+    bool m = true;
+    for (uint32_t j = 0; j < pl; ++j) {
+      if (d[i + j] != p[j]) { m = false; break; }
+    }
+    if (!m) continue;
+    uint32_t k = i + pl;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t(':')) continue;
+    ++k;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    uint32_t s = k, e = k;
+    if (e < n && (d[e] == char16_t('-') || d[e] == char16_t('+'))) ++e;
+    uint32_t ds = e;
+    while (e < n && d[e] >= char16_t('0') && d[e] <= char16_t('9')) ++e;
+    if (e == ds) continue;
+    nsAutoString num(Substring(aJson, s, e - s));
+    nsresult rv;
+    int32_t v = num.ToInteger(&rv);
+    if (NS_FAILED(rv)) continue;
+    aOut = v;
+    return true;
+  }
+  return false;
+}
