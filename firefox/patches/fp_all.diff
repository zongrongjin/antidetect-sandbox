+// //BROWSER_FINGERPRINT: 画像 acceptLanguages 覆盖 navigator.language(s)
+void WorkerNavigator::GetLanguages(nsTArray<nsString>& aLanguages) const {
+  nsString fpj = FpWNProfile();
+  nsAutoString fpv;
+  if (!fpj.IsEmpty() && FpWNExtractStr(fpj, "acceptLanguages", fpv) &&
+      !fpv.IsEmpty()) {
+    for (const nsAString& part : fpv.Split(char16_t(','))) {
+      nsAutoString lang(part);
+      // //BROWSER_FINGERPRINT: 剥掉 q 值 —— navigator.languages 里绝不出现 ";q=",
+      // 与主线程 Navigator::GetLanguages 同款（q 值只在 Accept-Language 请求头里）。
+      int32_t semi = lang.FindChar(char16_t(';'));
+      if (semi >= 0) {
+        lang.Truncate(semi);
+      }
+      lang.Trim(" \t");
+      if (!lang.IsEmpty()) {
+        aLanguages.AppendElement(lang);
+      }
+    }
+    if (!aLanguages.IsEmpty()) {
+      return;
+    }
+  }
+  aLanguages = mProperties.mLanguages.Clone();
+}
+
+void WorkerNavigator::GetLanguage(nsString& aLanguage) const {
+  nsTArray<nsString> langs;
+  GetLanguages(langs);
+  aLanguage.Truncate();
+  if (!langs.IsEmpty()) {
+    aLanguage.Assign(langs[0]);
+  } else if (mProperties.mLanguages.Length() >= 1) {
+    aLanguage.Assign(mProperties.mLanguages[0]);
+  }
+}
