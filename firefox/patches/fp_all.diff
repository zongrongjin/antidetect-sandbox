+  nsAutoString pat;
+  pat.Append(char16_t('"'));
+  pat.AppendASCII(key);
+  pat.Append(char16_t('"'));
+  const char16_t* d = j.BeginReading();
+  const char16_t* p = pat.BeginReading();
+  uint32_t n = j.Length(), pl = pat.Length();
+  for (uint32_t i = 0; i + pl <= n; ++i) {
+    bool m = true;
+    for (uint32_t k = 0; k < pl; ++k) {
+      if (d[i + k] != p[k]) { m = false; break; }
+    }
+    if (!m) continue;
+    uint32_t k = i + pl;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t(':')) continue;
+    ++k;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
