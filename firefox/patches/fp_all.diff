+  if (!JS_GetProperty(cx, rootObject, "webGPU", &webgpu) ||
+      !webgpu.isObject()) {
+    return std::nullopt;
+  }
+  JS::Rooted<JSObject*> webgpuObject(cx, &webgpu.toObject());
+  if (!JS_GetProperty(cx, webgpuObject, "features", &features)) {
+    return std::nullopt;
+  }
+  if (!features.isObject())
+    return std::nullopt;
+  JS::Rooted<JSObject*> array(cx, &features.toObject());
+  bool isArray = false;
+  uint32_t length = 0;
+  if (!JS::IsArrayObject(cx, array, &isArray) || !isArray ||
+      !JS::GetArrayLength(cx, array, &length)) {
+    return std::nullopt;
