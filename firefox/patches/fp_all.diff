+static bool MaybeResolveFingerprintMediaDevices(
+    nsPIDOMWindowInner* aWindow, Promise* aPromise) {
+  BrowsingContext* context =
+      aWindow ? aWindow->GetBrowsingContext() : nullptr;
+  if (!context) {
+    return false;
+  }
+  const nsString fingerprint =
+      context->Top()->GetFingerprintProfile();
+  if (fingerprint.IsEmpty()) {
+    return false;
+  }
+
+  nsTArray<RefPtr<MediaDeviceInfo>> infos;
+  bool configured = false;
+  {
+    AutoJSAPI jsapi;
+    if (!jsapi.Init(aWindow)) {
+      return false;
+    }
+    JSContext* cx = jsapi.cx();
+    JS::Rooted<JS::Value> root(cx);
+    if (JS_ParseJSON(cx, fingerprint.BeginReading(), fingerprint.Length(),
+                     &root) &&
+        root.isObject()) {
+      JS::Rooted<JSObject*> rootObject(cx, &root.toObject());
+      JS::Rooted<JS::Value> devices(cx);
+      if (JS_GetProperty(cx, rootObject, "mediaDevices", &devices) &&
+          devices.isObject()) {
+        JS::Rooted<JSObject*> array(cx, &devices.toObject());
+        bool isArray = false;
+        uint32_t length = 0;
+        if (JS::IsArrayObject(cx, array, &isArray) && isArray &&
+            JS::GetArrayLength(cx, array, &length)) {
+          configured = true;
+          auto getString = [cx](JS::Handle<JSObject*> object,
+                                const char* key,
+                                nsAString& output) -> bool {
+            JS::Rooted<JS::Value> value(cx);
+            if (!JS_GetProperty(cx, object, key, &value) ||
+                !value.isString()) {
+              return false;
+            }
+            nsAutoJSString stringValue;
+            if (!stringValue.init(cx, value.toString())) return false;
+            output.Assign(stringValue);
+            return true;
+          };
+          for (uint32_t i = 0; i < length; ++i) {
+            JS::Rooted<JS::Value> entry(cx);
+            if (!JS_GetElement(cx, array, i, &entry) ||
+                !entry.isObject()) {
+              continue;
+            }
+            JS::Rooted<JSObject*> object(cx, &entry.toObject());
+            nsAutoString kindString;
+            nsAutoString id;
+            nsAutoString label;
+            nsAutoString group;
+            if (!getString(object, "kind", kindString)) continue;
+            getString(object, "deviceId", id);
+            getString(object, "label", label);
+            getString(object, "groupId", group);
+            MediaDeviceKind kind;
+            if (kindString.EqualsLiteral("audioinput")) {
+              kind = MediaDeviceKind::Audioinput;
+            } else if (kindString.EqualsLiteral("videoinput")) {
+              kind = MediaDeviceKind::Videoinput;
+            } else if (kindString.EqualsLiteral("audiooutput")) {
+              kind = MediaDeviceKind::Audiooutput;
+            } else {
+              continue;
+            }
+            infos.AppendElement(
+                MakeRefPtr<MediaDeviceInfo>(id, kind, label, group));
+          }
+        }
+      }
+    }
+    JS_ClearPendingException(cx);
+  }
+  if (!configured) {
+    return false;
+  }
+  aPromise->MaybeResolve(std::move(infos));
+  return true;
+}
