+// //BROWSER_FINGERPRINT: service worker 无创建者 window。父进程侧尽力：遍历所有
+// 活跃 top-level BrowsingContext，优先取与 SW 主体同源(同源=同画像)者的画像快照；
+// 无同源匹配则回退任一非空画像。SWM 仅父进程有状态，运行于父进程主线程。
+namespace {
+static nsString FpFindProfileForServiceWorker(nsIPrincipal* aPrincipal) {
+  nsString anyProfile;
+  bool multipleDistinct = false;
+  nsAutoCString wantOrigin;
+  if (aPrincipal) {
+    // //BROWSER_FINGERPRINT: 带后缀(含 userContextId)，精确到容器
+    aPrincipal->GetOrigin(wantOrigin);
+  }
+  AutoTArray<RefPtr<BrowsingContextGroup>, 32> groups;
+  BrowsingContextGroup::GetAllGroups(groups);
+  for (auto& group : groups) {
+    for (auto& top : group->Toplevels()) {
+      if (!top) {
+        continue;
+      }
+      nsString prof = top->GetFingerprintProfile();
+      if (prof.IsEmpty()) {
+        continue;
+      }
+      if (anyProfile.IsEmpty()) {
+        anyProfile = prof;
+      } else if (prof != anyProfile) {
+        multipleDistinct = true;
+      }
+      if (!wantOrigin.IsEmpty() && XRE_IsParentProcess()) {
+        if (WindowGlobalParent* wgp =
+                top->Canonical()->GetCurrentWindowGlobal()) {
+          if (nsIPrincipal* docp = wgp->DocumentPrincipal()) {
+            nsAutoCString gotOrigin;
+            if (NS_SUCCEEDED(docp->GetOrigin(gotOrigin)) &&
+                gotOrigin == wantOrigin) {
+              return prof;  // //BROWSER_FINGERPRINT: 同源+同容器(userContextId)精确匹配
+            }
+          }
+        }
+      }
+    }
+  }
+  // //BROWSER_FINGERPRINT: 回退仅在全局唯一画像时用(单 context/全局下发);
+  // 多个不同画像却没精确匹配 -> 返回空走 native, 绝不乱猜(防跨容器串画像)
+  if (multipleDistinct) {
+    return nsString();
+  }
+  return anyProfile;
+}
