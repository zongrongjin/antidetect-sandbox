+template <typename Callback>
+bool WithFingerprintAdapterValue(const AdapterInfo* aInfo, const char* aKey,
+                                 Callback&& aCallback) {
+  Instance* instance = aInfo->FingerprintInstance();
+  nsString fingerprint = instance->FingerprintProfile();
+  dom::AutoJSAPI jsapi;
+  if (fingerprint.IsEmpty() || !jsapi.Init(instance->GetParentObject())) {
+    return false;
+  }
+  JSContext* cx = jsapi.cx();
+  JS::Rooted<JS::Value> root(cx);
+  JS::Rooted<JS::Value> webgpu(cx);
+  JS::Rooted<JS::Value> adapter(cx);
+  JS::Rooted<JS::Value> value(cx);
+  if (!JS_ParseJSON(cx, fingerprint.BeginReading(), fingerprint.Length(),
+                    &root) ||
+      !root.isObject()) {
+    JS_ClearPendingException(cx);
+    return false;
+  }
+  JS::Rooted<JSObject*> rootObject(cx, &root.toObject());
+  if (!JS_GetProperty(cx, rootObject, "webGPU", &webgpu) ||
+      !webgpu.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> webgpuObject(cx, &webgpu.toObject());
+  if (!JS_GetProperty(cx, webgpuObject, "adapter", &adapter) ||
+      !adapter.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> adapterObject(cx, &adapter.toObject());
+  if (!JS_GetProperty(cx, adapterObject, aKey, &value)) {
+    JS_ClearPendingException(cx);
+    return false;
+  }
+  return aCallback(cx, value);
+}
+
+bool FingerprintAdapterString(const AdapterInfo* aInfo, const char* aKey,
+                              nsString& aResult) {
+  return WithFingerprintAdapterValue(
+      aInfo, aKey, [&aResult](JSContext* aCx, JS::Handle<JS::Value> aValue) {
+        if (!aValue.isString())
+          return false;
+        nsAutoJSString text;
+        if (!text.init(aCx, aValue.toString()))
+          return false;
+        aResult = text;
+        return true;
+      });
+}
+
+bool FingerprintAdapterUint(const AdapterInfo* aInfo, const char* aKey,
+                            uint32_t& aResult) {
+  return WithFingerprintAdapterValue(
+      aInfo, aKey, [&aResult](JSContext*, JS::Handle<JS::Value> aValue) {
+        if (!aValue.isNumber())
+          return false;
+        double number = aValue.toNumber();
+        if (number < 0 || number > UINT32_MAX)
+          return false;
+        aResult = static_cast<uint32_t>(number);
+        return true;
+      });
