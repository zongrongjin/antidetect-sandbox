+static void ApplyFingerprintLimits(Instance* aInstance,
+                                   ffi::WGPULimits* aLimits) {
+  nsString fingerprint = aInstance->FingerprintProfile();
+  dom::AutoJSAPI jsapi;
+  if (fingerprint.IsEmpty() || !jsapi.Init(aInstance->GetParentObject()))
+    return;
+  JSContext* cx = jsapi.cx();
+  JS::Rooted<JS::Value> root(cx);
+  JS::Rooted<JS::Value> webgpu(cx);
+  JS::Rooted<JS::Value> limits(cx);
+  if (!JS_ParseJSON(cx, fingerprint.BeginReading(), fingerprint.Length(),
+                    &root) ||
+      !root.isObject()) {
+    JS_ClearPendingException(cx);
+    return;
+  }
+  JS::Rooted<JSObject*> rootObject(cx, &root.toObject());
+  if (!JS_GetProperty(cx, rootObject, "webGPU", &webgpu) ||
+      !webgpu.isObject()) {
+    return;
+  }
+  JS::Rooted<JSObject*> webgpuObject(cx, &webgpu.toObject());
+  if (!JS_GetProperty(cx, webgpuObject, "limits", &limits) ||
+      !limits.isObject()) {
+    return;
+  }
+  JS::Rooted<JSObject*> limitsObject(cx, &limits.toObject());
+  for (uint8_t raw = 0; raw <= static_cast<uint8_t>(Limit::_LAST); ++raw) {
+    Limit limit = static_cast<Limit>(raw);
+    std::string key(ToJsKey(limit));
+    JS::Rooted<JS::Value> value(cx);
+    if (!JS_GetProperty(cx, limitsObject, key.c_str(), &value) ||
+        !value.isNumber()) {
+      continue;
+    }
+    double requested = value.toNumber();
+    if (requested < 0 || requested > double(UINT64_MAX))
+      continue;
+    uint64_t native = GetLimit(*aLimits, limit);
+    uint64_t wanted = static_cast<uint64_t>(requested);
+    if (limit == Limit::MinUniformBufferOffsetAlignment ||
+        limit == Limit::MinStorageBufferOffsetAlignment) {
+      wanted = std::max(native, wanted);
+    } else {
+      wanted = std::min(native, wanted);
+    }
+    SetLimit(aLimits, limit, wanted);
+  }
+}
