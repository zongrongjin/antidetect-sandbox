+    return result || { found: false };
+  }
+
+  async #deepLocateRecursive(context, selector, bidiId, ox, oy) {
+    let res = null;
+    try {
+      res = await this._forwardToWindowGlobal(
+        "_deepLocate",
+        context.id,
+        { selector },
+        { retryOnAbort: true }
+      );
+    } catch (e) {
+      res = null;
+    }
+
+    if (res && res.found) {
+      const r = res.rect;
+      return {
+        found: true,
+        context: bidiId,
+        offset: { x: ox, y: oy },
+        local: r,
+        rect: {
+          x: ox + r.x,
+          y: oy + r.y,
+          width: r.width,
+          height: r.height,
+        },
+        node: res.node,
+      };
+    }
+
+    const children = context.children || [];
+    if (!children.length) {
+      return null;
+    }
+
+    let rects = [];
+    try {
+      const ir = await this._forwardToWindowGlobal(
+        "_iframeRects",
+        context.id,
+        {},
+        { retryOnAbort: true }
+      );
+      rects = (ir && ir.rects) || [];
+    } catch (e) {
+      rects = [];
+    }
+
+    for (let i = 0; i < children.length; i++) {
+      const io = rects[i] || { x: 0, y: 0 };
+      const childBidiId = lazy.NavigableManager.getIdForBrowsingContext(
+        children[i]
+      );
+      const found = await this.#deepLocateRecursive(
+        children[i],
+        selector,
+        childBidiId,
+        ox + io.x,
+        oy + io.y
