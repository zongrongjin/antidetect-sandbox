+// BROWSER_FINGERPRINT: 从画像 JSON 取一个数字键。Navigator.cpp 里有同名逻辑但
+// 是 static(编译单元私有)，此处自带一份，避免跨 TU 暴露符号。
+static bool FpBcExtractInt(const nsAString& aJson, const char* aKey,
+                           int32_t& aOut) {
+  nsAutoString pat; pat.Append(char16_t('"')); pat.AppendASCII(aKey); pat.Append(char16_t('"'));
+  const char16_t* d = aJson.BeginReading(); const char16_t* p = pat.BeginReading();
+  uint32_t n = aJson.Length(), pl = pat.Length();
+  for (uint32_t i = 0; i + pl <= n; ++i) {
+    bool m = true;
+    for (uint32_t j = 0; j < pl; ++j) { if (d[i + j] != p[j]) { m = false; break; } }
+    if (!m) continue;
+    uint32_t k = i + pl;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    if (k >= n || d[k] != char16_t(':')) continue;
+    ++k;
+    while (k < n && (d[k] == char16_t(' ') || d[k] == char16_t('\t'))) ++k;
+    uint32_t s = k, e = k;
+    if (e < n && (d[e] == char16_t('-') || d[e] == char16_t('+'))) ++e;
+    uint32_t ds = e;
+    while (e < n && d[e] >= char16_t('0') && d[e] <= char16_t('9')) ++e;
+    if (e == ds) continue;
+    nsAutoString num(Substring(aJson, s, e - s));
+    nsresult rv; int32_t v = num.ToInteger(&rv);
+    if (NS_FAILED(rv)) continue;
+    aOut = v; return true;
+  }
+  return false;
+}
+
 TouchEventsOverride BrowsingContext::TouchEventsOverride() const {
+  const BrowsingContext* top = this;
   for (const auto* bc = this; bc; bc = bc->GetParent()) {
     auto tev = bc->GetTouchEventsOverrideInternal();
     if (tev != dom::TouchEventsOverride::None) {
       return tev;
     }
+    top = bc;
+  }
+  // BROWSER_FINGERPRINT: 无显式 RDM 覆盖时，从画像 maxTouchPoints 推导触摸能力，
+  // 使 TouchEvent/ontouchstart 与 pointer:coarse/hover:none 跟 navigator
+  // .maxTouchPoints 自洽。未设该键则回退原生(返回 None)。
+  nsString fpj = top->GetFingerprintProfile();
+  int32_t mtp;
+  if (!fpj.IsEmpty() && FpBcExtractInt(fpj, "maxTouchPoints", mtp)) {
+    return mtp > 0 ? dom::TouchEventsOverride::Enabled
+                   : dom::TouchEventsOverride::Disabled;
   }
   return dom::TouchEventsOverride::None;
 }
