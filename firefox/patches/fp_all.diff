index 0000000..04038df
--- /dev/null
+++ b/remote/webdriver-bidi/modules/root/moz/fingerprint.sys.mjs
@@ -0,0 +1,189 @@
+/* BROWSER_FINGERPRINT */
+import { RootBiDiModule } from "chrome://remote/content/webdriver-bidi/modules/RootBiDiModule.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  assert: "chrome://remote/content/shared/webdriver/Assert.sys.mjs",
+  NavigableManager:
+    "chrome://remote/content/shared/NavigableManager.sys.mjs",
+  pprint: "chrome://remote/content/shared/Format.sys.mjs",
+  RootMessageHandler:
+    "chrome://remote/content/shared/messagehandler/RootMessageHandler.sys.mjs",
+});
+
+/**
+ * moz:fingerprint module (root). Routes the per-context fingerprint profile
+ * through the standard _configuration/SessionData machinery so that:
+ *  - it can be scoped per browsing context (contexts) or per user context
+ *    (userContexts), or applied globally when neither is given, and
+ *  - future top-level browsing contexts created within the scope inherit it
+ *    (replayed from SessionData via _configuration.#onContextAttached).
+ */
+class FingerprintModule extends RootBiDiModule {
+  constructor(messageHandler) {
+    super(messageHandler);
+  }
+
+  destroy() {}
+
+  /**
+   * Set the fingerprint profile override.
+   *
+   * @param {object=} params
+   * @param {string=} params.fingerprint
+   *     Fingerprint profile as a JSON string. Empty string resets the override.
+   * @param {Array<string>=} params.contexts
+   *     Optional list of top-level browsing context ids to scope to.
+   * @param {Array<string>=} params.userContexts
+   *     Optional list of user context ids to scope to.
+   */
+  async setContextOverrides(params = {}) {
+    const {
+      fingerprint = "",
+      contexts: contextIds,
+      userContexts: userContextIds,
+    } = params;
+
+    lazy.assert.string(
+      fingerprint,
+      lazy.pprint`Expected "fingerprint" to be a string, got ${fingerprint}`
+    );
+
+    await this.messageHandler.handleCommand({
+      moduleName: "_configuration",
+      commandName: "_applyConfigurationParameters",
+      destination: { type: lazy.RootMessageHandler.type },
+      params: {
+        async: false,
+        category: "fingerprint-override",
+        contextIds,
+        resetValue: "",
+        supportsGlobalConfiguration: true,
+        userContextIds,
+        value: fingerprint,
+      },
+    });
+
+    return {};
+  }
+
+  /**
+   * Deep-locate the first element matching `selector`, piercing closed shadow
+   * DOM (natively, via the windowglobal module) and recursing across child
+   * browsing contexts (same-process iframes and cross-origin OOPIFs).
+   *
+   * Forwards `_deepLocate` to the target context's windowglobal module (see
+   * browsingContext.locateNodes for the same forward pattern). On a miss it
+   * recurses into each child browsing context, accumulating the child's
+   * embedder viewport offset so the returned rectangle is expressed in the
+   * top-level (given context) viewport.
+   *
+   * @param {object=} params
+   * @param {string} params.selector
+   *     CSS selector to look up.
+   * @param {string} params.context
+   *     Top-level browsing context (navigable) id to search from.
+   *
+   * @returns {object}
+   *     `{ found:true, context, offset:{x,y}, local:{x,y,width,height},
+   *        rect:{x,y,width,height}, node }` where `rect` is the top-level
+   *     absolute viewport rectangle, `local` is the rectangle inside the
+   *     browsing context where the element was found and `context` is that
+   *     context's BiDi id (usable for input.performActions). `{ found:false }`
+   *     when nothing matches.
+   */
+  async deepLocate(params = {}) {
+    const { selector, context: navigableId } = params;
+
+    lazy.assert.string(
+      selector,
+      lazy.pprint`Expected "selector" to be a string, got ${selector}`
+    );
+    lazy.assert.string(
+      navigableId,
+      lazy.pprint`Expected "context" to be a string, got ${navigableId}`
+    );
+
+    const context = this._getNavigable(navigableId);
+
+    const result = await this.#deepLocateRecursive(
+      context,
+      selector,
+      navigableId,
+      0,
+      0
+    );
+
+    return result || { found: false };
+  }
+
+  async #deepLocateRecursive(context, selector, bidiId, ox, oy) {
+    let res = null;
+    try {
+      res = await this._forwardToWindowGlobal(
+        "_deepLocate",
+        context.id,
+        { selector },
+        { retryOnAbort: true }
+      );
+    } catch (e) {
+      res = null;
+    }
+
+    if (res && res.found) {
+      const r = res.rect;
+      return {
+        found: true,
+        context: bidiId,
+        offset: { x: ox, y: oy },
+        local: r,
+        rect: {
+          x: ox + r.x,
+          y: oy + r.y,
+          width: r.width,
+          height: r.height,
+        },
+        node: res.node,
+      };
+    }
+
+    const children = context.children || [];
+    if (!children.length) {
+      return null;
+    }
+
+    let rects = [];
+    try {
+      const ir = await this._forwardToWindowGlobal(
+        "_iframeRects",
+        context.id,
+        {},
+        { retryOnAbort: true }
+      );
+      rects = (ir && ir.rects) || [];
+    } catch (e) {
+      rects = [];
+    }
+
+    for (let i = 0; i < children.length; i++) {
+      const io = rects[i] || { x: 0, y: 0 };
+      const childBidiId = lazy.NavigableManager.getIdForBrowsingContext(
+        children[i]
+      );
+      const found = await this.#deepLocateRecursive(
+        children[i],
+        selector,
+        childBidiId,
+        ox + io.x,
+        oy + io.y
+      );
+      if (found) {
+        return found;
+      }
+    }
+
+    return null;
+  }
+}
+
+export const fingerprint = FingerprintModule;
diff --git a/remote/webdriver-bidi/modules/root/moz/proxy.sys.mjs b/remote/webdriver-bidi/modules/root/moz/proxy.sys.mjs
new file mode 100644
index 0000000..2eb1d0d
--- /dev/null
+++ b/remote/webdriver-bidi/modules/root/moz/proxy.sys.mjs
@@ -0,0 +1,161 @@
+/* BROWSER_FINGERPRINT */
+import { RootBiDiModule } from "chrome://remote/content/webdriver-bidi/modules/RootBiDiModule.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  assert: "chrome://remote/content/shared/webdriver/Assert.sys.mjs",
+  pprint: "chrome://remote/content/shared/Format.sys.mjs",
+  UserContextManager:
+    "chrome://remote/content/shared/UserContextManager.sys.mjs",
+});
+
+const { TRANSPARENT_PROXY_RESOLVES_HOST } = Ci.nsIProxyInfo;
+
+// Per-userContext (internal integer id) upstream proxy routing table.
+// Module-level singleton in the parent process, shared across sessions.
+// internalUserContextId -> { type, host, port, username, password }
+const gProxyByUserContext = new Map();
+
+let gProxyService = null;
+function proxyService() {
+  if (!gProxyService) {
+    gProxyService = Cc[
+      "@mozilla.org/network/protocol-proxy-service;1"
+    ].getService(Ci.nsIProtocolProxyService);
+  }
+  return gProxyService;
+}
+
+// nsIProtocolProxyChannelFilter: consulted at proxy resolution for EVERY channel.
+// Routes the channel to its userContext's upstream proxy, carrying per-context
+// credentials on the returned nsProxyInfo. The native auth-provider patch
+// (nsHttpChannelAuthProvider::SetAuthorizationHeader) turns Username()/Password()
+// into a preemptive "Proxy-Authorization: Basic ..." — no local transit, no 407.
+const gFilter = {
+  QueryInterface: ChromeUtils.generateQI(["nsIProtocolProxyChannelFilter"]),
+  applyFilter(channel, defaultProxyInfo, callback) {
+    let pi = defaultProxyInfo;
+    try {
+      const uid = channel.loadInfo?.originAttributes?.userContextId ?? 0;
+      const o = gProxyByUserContext.get(uid);
+      if (o) {
+        pi = proxyService().newProxyInfoWithAuth(
+          o.type,
+          o.host,
+          o.port,
+          o.username,
+          o.password,
+          "", // proxyAuthorizationHeader (empty -> native patch synthesizes Basic)
+          "", // connectionIsolationKey
+          TRANSPARENT_PROXY_RESOLVES_HOST, // proxyDNS: resolve at the proxy (no DNS leak)
+          -1, // failoverTimeout
+          null // failoverProxy
+        );
+      }
+    } catch (e) {
+      pi = defaultProxyInfo;
+    }
+    callback.onProxyFilterResult(pi);
+  },
+};
+
+let gRegistered = false;
+function ensureRegistered() {
+  if (!gRegistered) {
+    proxyService().registerChannelFilter(gFilter, 0);
+    gRegistered = true;
+  }
+}
+
+function parseEndpoint(endpoint) {
+  // "http|https|socks5|socks4://host:port" or bare "host:port" (default http).
+  let type = "http";
+  let rest = endpoint;
+  const m = /^([a-zA-Z0-9]+):\/\/(.*)$/.exec(endpoint);
+  if (m) {
+    const scheme = m[1].toLowerCase();
+    rest = m[2];
+    if (scheme === "socks5" || scheme === "socks") {
+      type = "socks";
+    } else if (scheme === "socks4") {
+      type = "socks4";
+    } else if (scheme === "https") {
+      type = "https";
+    } else {
+      type = "http";
+    }
+  }
+  const idx = rest.lastIndexOf(":");
+  return {
+    type,
+    host: rest.slice(0, idx),
+    port: parseInt(rest.slice(idx + 1), 10),
+  };
+}
+
+/**
+ * moz:proxy module (root). Per-userContext upstream proxy + credentials,
+ * delivered natively via an nsIProtocolProxyChannelFilter keyed by the channel's
+ * originAttributes.userContextId. No session-level proxy, no local transit, no
+ * 407 round-trip. Each context (distinct userContextId) is structurally isolated
+ * both in routing and in the connection pool (originAttributes is always part of
+ * the connection hash key).
+ */
+class ProxyModule extends RootBiDiModule {
+  constructor(messageHandler) {
+    super(messageHandler);
+  }
+
+  destroy() {}
+
+  /**
+   * Set (or clear) the per-user-context upstream proxy override.
+   *
+   * @param {object=} params
+   * @param {string=} params.endpoint
+   *     "http|https|socks5://host:port" or bare "host:port" (http). Empty string
+   *     clears the override for the given user contexts.
+   * @param {string=} params.username
+   * @param {string=} params.password
+   * @param {Array<string>=} params.userContexts
+   *     BiDi user context ids to scope to.
+   */
+  async setContextOverrides(params = {}) {
+    const {
+      endpoint = "",
+      username = "",
+      password = "",
+      userContexts: userContextIds = [],
+    } = params;
+
+    lazy.assert.string(
+      endpoint,
+      lazy.pprint`Expected "endpoint" to be a string, got ${endpoint}`
+    );
+
+    ensureRegistered();
+
+    const parsed = endpoint ? parseEndpoint(endpoint) : null;
+    for (const bidiId of userContextIds) {
+      const internalId = lazy.UserContextManager.getInternalIdById(bidiId);
+      if (internalId === undefined || internalId === null) {
+        continue;
+      }
+      if (!parsed) {
+        gProxyByUserContext.delete(internalId);
+      } else {
+        gProxyByUserContext.set(internalId, {
+          type: parsed.type,
+          host: parsed.host,
+          port: parsed.port,
+          username,
+          password,
+        });
+      }
+    }
+
+    return {};
+  }
+}
+
+export const proxy = ProxyModule;
diff --git a/remote/webdriver-bidi/modules/windowglobal/moz/fingerprint.sys.mjs b/remote/webdriver-bidi/modules/windowglobal/moz/fingerprint.sys.mjs
new file mode 100644
index 0000000..80f76b4
--- /dev/null
+++ b/remote/webdriver-bidi/modules/windowglobal/moz/fingerprint.sys.mjs
@@ -0,0 +1,150 @@
+/* BROWSER_FINGERPRINT
+ *
+ * moz:fingerprint windowglobal module.
+ *
+ * Native, page-invisible closed-shadow piercing for deep element location.
+ *
+ * This module runs in the content process with a system principal, so it can
+ * read `el.openOrClosedShadowRoot` -- a chrome-only property that pierces
+ * *closed* shadow roots. Page scripts cannot access this property, and
+ * Element.prototype.attachShadow stays 100% native (no monkey-patch), so the
+ * previous detection surface (attachShadow.toString() no longer [native code],
+ * closed shadowRoot leaking to the page) is completely gone.
+ */
+import { WindowGlobalBiDiModule } from "chrome://remote/content/webdriver-bidi/modules/WindowGlobalBiDiModule.sys.mjs";
+
+const lazy = {};
+
+ChromeUtils.defineESModuleGetters(lazy, {
+  dom: "chrome://remote/content/shared/DOM.sys.mjs",
+  OwnershipModel: "chrome://remote/content/webdriver-bidi/RemoteValue.sys.mjs",
+  setDefaultAndAssertSerializationOptions:
+    "chrome://remote/content/webdriver-bidi/RemoteValue.sys.mjs",
+});
+
+class FingerprintModule extends WindowGlobalBiDiModule {
+  constructor(messageHandler) {
+    super(messageHandler);
+  }
+
+  destroy() {}
+
+  /**
+   * Return the open OR closed shadow root of an element, using the chrome-only
+   * `openOrClosedShadowRoot` property (invisible to page scripts). Returns null
+   * when the element has no usable shadow root.
+   */
+  #shadowRootOf(el) {
+    try {
+      const sr = el.openOrClosedShadowRoot;
+      if (sr && !sr.isUAWidget()) {
+        return sr;
+      }
+    } catch (e) {
+      // openOrClosedShadowRoot can throw for some nodes; treat as "no shadow".
+    }
+    return null;
+  }
+
+  /**
+   * Recursively query `selector` within `root` (a Document or ShadowRoot),
+   * descending into every element's open/closed shadow root. Returns the first
+   * matching Element, or null.
+   */
+  #deepQuery(root, selector) {
+    let el;
+    try {
+      el = root.querySelector(selector);
+    } catch (e) {
+      // Invalid selector -> no match (do not throw across the wire).
+      return null;
+    }
+    if (el) {
+      return el;
+    }
+    const all = root.querySelectorAll("*");
+    for (let i = 0; i < all.length; i++) {
+      const sr = this.#shadowRootOf(all[i]);
+      if (sr) {
+        const found = this.#deepQuery(sr, selector);
+        if (found) {
+          return found;
+        }
+      }
+    }
+    return null;
+  }
+
+  /**
+   * Locate the first element matching `selector` in this window global,
+   * piercing (open and closed) shadow roots. Returns the element's viewport
+   * rectangle and a serialized node reference (sharedId) so the client can
+   * drive it later, or `{ found: false }` when nothing matches.
+   *
+   * @param {object=} params
+   * @param {string} params.selector
+   *     CSS selector to look up.
+   */
+  async _deepLocate(params = {}) {
+    const { selector } = params;
+    const doc = this.messageHandler.window.document;
+    const el = this.#deepQuery(doc, selector);
+    if (!el) {
+      return { found: false, rect: null, node: null };
+    }
+
+    const r = el.getBoundingClientRect();
+    const rect = { x: r.x, y: r.y, width: r.width, height: r.height };
+
+    // Serialize the node so find(deep=True) can build an Element handle and
+    // drive it later via sharedId. OwnershipModel.None is enough: the node
+    // remains resolvable by sharedId while it lives in the DOM.
+    let node = null;
+    try {
+      const realm = this.messageHandler.getRealm();
+      const serializationOptions =
+        lazy.setDefaultAndAssertSerializationOptions({});
+      node = this.serialize(
+        el,
+        serializationOptions,
+        lazy.OwnershipModel.None,
+        realm,
+        { seenNodeIds: new Map() }
+      );
+    } catch (e) {
+      node = null;
+    }
+
+    return { found: true, rect, node };
+  }
+
+  /**
+   * Viewport rectangles ({x, y}) of every <iframe> element in this window
+   * global, including iframes nested inside open/closed shadow roots, in DOM
+   * order. The root module uses these offsets to translate child browsing
+   * context coordinates into the top-level viewport for cross-frame deep
+   * location.
+   */
+  async _iframeRects() {
+    const doc = this.messageHandler.window.document;
+    const out = [];
+    const collect = root => {
+      const frames = root.querySelectorAll("iframe");
+      for (let i = 0; i < frames.length; i++) {
+        const fr = frames[i].getBoundingClientRect();
+        out.push({ x: fr.x, y: fr.y });
+      }
+      const all = root.querySelectorAll("*");
+      for (let j = 0; j < all.length; j++) {
+        const sr = this.#shadowRootOf(all[j]);
+        if (sr) {
+          collect(sr);
+        }
+      }
+    };
+    collect(doc);
+    return { rects: out };
+  }
+}
+
+export const fingerprint = FingerprintModule;
