+bool Connection::Enabled(JSContext* aCx, JSObject* aGlobal) {
+  // BROWSER_FINGERPRINT_ANDROID_SURFACE: Android 画像或 connection 对象 → 露出 API；false / iOS → 隐藏；否则跟 pref。
+  nsAutoString json;
