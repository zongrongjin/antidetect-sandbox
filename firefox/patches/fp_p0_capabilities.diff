+nsString Instance::FingerprintProfile() const {
+  nsAutoString fingerprint;
+  if (NS_IsMainThread()) {
+    nsCOMPtr<nsPIDOMWindowInner> window = do_QueryInterface(mGlobal);
+    if (dom::Document* doc = window ? window->GetExtantDoc() : nullptr) {
+      if (dom::BrowsingContext* context = doc->GetBrowsingContext()) {
+        fingerprint = context->Top()->GetFingerprintProfile();
+      }
+    }
+  } else if (dom::WorkerPrivate* worker =
+                 dom::GetCurrentThreadWorkerPrivate()) {
+    fingerprint = worker->GetFingerprintProfile();
+  }
+  return fingerprint;
+}
+
+dom::GPUTextureFormat Instance::GetPreferredCanvasFormat() const {
+  nsString fingerprint = FingerprintProfile();
+  if (!fingerprint.IsEmpty()) {
+    dom::AutoJSAPI jsapi;
+    if (jsapi.Init(mGlobal)) {
+      JSContext* cx = jsapi.cx();
+      JS::Rooted<JS::Value> root(cx);
+      if (JS_ParseJSON(cx, fingerprint.BeginReading(), fingerprint.Length(),
+                       &root) &&
+          root.isObject()) {
+        JS::Rooted<JS::Value> webgpu(cx);
+        JS::Rooted<JS::Value> format(cx);
+        JS::Rooted<JSObject*> rootObject(cx, &root.toObject());
+        if (JS_GetProperty(cx, rootObject, "webGPU", &webgpu) &&
+            webgpu.isObject()) {
+          JS::Rooted<JSObject*> webgpuObject(cx, &webgpu.toObject());
+          if (!JS_GetProperty(cx, webgpuObject, "preferredCanvasFormat",
+                              &format) ||
+              !format.isString()) {
+            return kIsAndroid ? dom::GPUTextureFormat::Rgba8unorm
+                              : dom::GPUTextureFormat::Bgra8unorm;
+          }
+          nsAutoJSString value;
+          if (value.init(cx, format.toString())) {
+            if (value.EqualsLiteral("rgba8unorm"))
+              return dom::GPUTextureFormat::Rgba8unorm;
+            if (value.EqualsLiteral("bgra8unorm"))
+              return dom::GPUTextureFormat::Bgra8unorm;
+          }
+        }
+      } else {
+        JS_ClearPendingException(cx);
+      }
+    }
+  }
+  return kIsAndroid ? dom::GPUTextureFormat::Rgba8unorm
+                    : dom::GPUTextureFormat::Bgra8unorm;
+}
