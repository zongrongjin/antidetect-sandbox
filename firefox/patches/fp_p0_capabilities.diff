+// BROWSER_FINGERPRINT: optional WebGL capability vector. The schema is:
+// "<enum>": {"type":"int|uint|float|bool|int32|float32","value":...}.
+// Any missing or malformed layer returns false and leaves native behavior.
+static bool FpwSetCapability(ClientWebGLContext* aContext, Document* aDocument,
+                             JSContext* aCx, bool aWebGL2, GLenum aPname,
+                             JS::MutableHandle<JS::Value> aRetval,
+                             ErrorResult& aRv) {
+  nsString fingerprint = FpRbProfileGl(aDocument);
+  if (fingerprint.IsEmpty()) {
+    return false;
+  }
+  JS::Rooted<JS::Value> root(aCx);
+  if (!JS_ParseJSON(aCx, fingerprint.BeginReading(), fingerprint.Length(),
+                    &root) ||
+      !root.isObject()) {
+    JS_ClearPendingException(aCx);
+    return false;
+  }
+  JS::Rooted<JSObject*> rootObject(aCx, &root.toObject());
+  JS::Rooted<JS::Value> parametersValue(aCx);
+  const char* profileKey =
+      aWebGL2 ? "webgl2Parameters" : "webglParameters";
+  if (!JS_GetProperty(aCx, rootObject, profileKey, &parametersValue) ||
+      !parametersValue.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> parametersObject(aCx,
+                                          &parametersValue.toObject());
+  nsPrintfCString enumKey("%u", aPname);
+  JS::Rooted<JS::Value> entryValue(aCx);
+  if (!JS_GetProperty(aCx, parametersObject, enumKey.get(), &entryValue) ||
+      !entryValue.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> entryObject(aCx, &entryValue.toObject());
+  JS::Rooted<JS::Value> typeValue(aCx);
+  JS::Rooted<JS::Value> value(aCx);
+  if (!JS_GetProperty(aCx, entryObject, "type", &typeValue) ||
+      !typeValue.isString() ||
+      !JS_GetProperty(aCx, entryObject, "value", &value)) {
+    return false;
+  }
+  nsAutoJSString type;
+  if (!type.init(aCx, typeValue.toString())) {
+    return false;
+  }
+  if (type.EqualsLiteral("bool") && value.isBoolean()) {
+    aRetval.setBoolean(value.toBoolean());
+    return true;
+  }
+  if ((type.EqualsLiteral("int") || type.EqualsLiteral("uint") ||
+       type.EqualsLiteral("float")) &&
+      value.isNumber()) {
+    aRetval.setNumber(value.toNumber());
+    return true;
+  }
+  if (!type.EqualsLiteral("int32") && !type.EqualsLiteral("float32")) {
+    return false;
+  }
+  if (!value.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> arrayObject(aCx, &value.toObject());
+  bool isArray = false;
+  uint32_t count = 0;
+  if (!JS::IsArrayObject(aCx, arrayObject, &isArray) || !isArray ||
+      !JS::GetArrayLength(aCx, arrayObject, &count)) {
+    return false;
+  }
+  if (type.EqualsLiteral("int32")) {
+    nsTArray<int32_t> values;
+    if (!values.SetCapacity(count, fallible)) {
+      aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+      return true;
+    }
+    for (uint32_t i = 0; i < count; ++i) {
+      JS::Rooted<JS::Value> item(aCx);
+      if (!JS_GetElement(aCx, arrayObject, i, &item) || !item.isNumber()) {
+        return false;
+      }
+      values.AppendElement(static_cast<int32_t>(item.toNumber()));
+    }
+    aRetval.set(Create<dom::Int32Array>(
+        aCx, aContext, Span(values.Elements(), values.Length()), aRv));
+    return true;
+  }
+  nsTArray<float> values;
+  if (!values.SetCapacity(count, fallible)) {
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return true;
+  }
+  for (uint32_t i = 0; i < count; ++i) {
+    JS::Rooted<JS::Value> item(aCx);
+    if (!JS_GetElement(aCx, arrayObject, i, &item) || !item.isNumber()) {
+      return false;
+    }
+    values.AppendElement(static_cast<float>(item.toNumber()));
+  }
+  aRetval.set(Create<dom::Float32Array>(
+      aCx, aContext, Span(values.Elements(), values.Length()), aRv));
+  return true;
+}
+
+static bool FpwShaderPrecision(Document* aDocument, bool aWebGL2,
+                               GLenum aShaderType, GLenum aPrecisionType,
+                               webgl::ShaderPrecisionFormat& aResult) {
+  nsString fingerprint = FpRbProfileGl(aDocument);
+  if (fingerprint.IsEmpty()) {
+    return false;
+  }
+  nsCOMPtr<nsIGlobalObject> global;
+  if (aDocument) {
+    global = aDocument->GetScopeObject();
+  } else if (WorkerPrivate* worker = GetCurrentThreadWorkerPrivate()) {
+    global = worker->GlobalScope();
+  }
+  if (!global) {
+    return false;
+  }
+  AutoJSAPI jsapi;
+  if (!jsapi.Init(global)) {
+    return false;
+  }
+  JSContext* cx = jsapi.cx();
+  JS::Rooted<JS::Value> root(cx);
+  if (!JS_ParseJSON(cx, fingerprint.BeginReading(), fingerprint.Length(),
+                    &root) ||
+      !root.isObject()) {
+    JS_ClearPendingException(cx);
+    return false;
+  }
+  JS::Rooted<JSObject*> rootObject(cx, &root.toObject());
+  JS::Rooted<JS::Value> profileValue(cx);
+  const char* profileKey =
+      aWebGL2 ? "webgl2ShaderPrecision" : "webglShaderPrecision";
+  if (!JS_GetProperty(cx, rootObject, profileKey, &profileValue) ||
+      !profileValue.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> profileObject(cx, &profileValue.toObject());
+  nsPrintfCString tupleKey("%u:%u", aShaderType, aPrecisionType);
+  JS::Rooted<JS::Value> tupleValue(cx);
+  if (!JS_GetProperty(cx, profileObject, tupleKey.get(), &tupleValue) ||
+      !tupleValue.isObject()) {
+    return false;
+  }
+  JS::Rooted<JSObject*> tupleObject(cx, &tupleValue.toObject());
+  bool isArray = false;
+  uint32_t count = 0;
+  if (!JS::IsArrayObject(cx, tupleObject, &isArray) || !isArray ||
+      !JS::GetArrayLength(cx, tupleObject, &count) || count != 3) {
+    return false;
+  }
+  uint8_t parts[3] = {};
+  for (uint32_t i = 0; i < 3; ++i) {
+    JS::Rooted<JS::Value> item(cx);
+    if (!JS_GetElement(cx, tupleObject, i, &item) || !item.isNumber()) {
+      return false;
+    }
+    const double number = item.toNumber();
+    if (number < 0 || number > 255) {
+      return false;
+    }
+    parts[i] = static_cast<uint8_t>(number);
+  }
+  aResult.rangeMin = parts[0];
+  aResult.rangeMax = parts[1];
+  aResult.precision = parts[2];
+  return true;
+}
