@@ -975,6 +975,33 @@ export class NetworkLogView extends Common.ObjectWrapper.eventMixin<EventTypes,
     return this.networkRequestToNode.get(request) || null;
   }
 
+  zzCacheRequests(): SDK.NetworkRequest.NetworkRequest[] {
+    return Logs.NetworkLog.NetworkLog.instance().requests().filter(request => this.isInScope(request));
+  }
+
+  requestForZzCache(requestId: string, url: string): SDK.NetworkRequest.NetworkRequest|null {
+    let urlMatch: SDK.NetworkRequest.NetworkRequest|null = null;
+    for (const request of this.zzCacheRequests()) {
+      if (requestId && request.requestId() === requestId) {
+        return request;
+      }
+      const tagged = request as SDK.NetworkRequest.NetworkRequest & {zzCacheAction?: string};
+      if (url && request.url() === url && !tagged.zzCacheAction) {
+        urlMatch = request;
+      }
+    }
+    return urlMatch;
+  }
+
+  applyZzCacheAction(request: SDK.NetworkRequest.NetworkRequest, action: string): void {
+    const tagged = request as SDK.NetworkRequest.NetworkRequest & {zzCacheAction?: string};
+    if (tagged.zzCacheAction === action) {
+      return;
+    }
+    tagged.zzCacheAction = action;
+    this.networkRequestToNode.get(request)?.refresh();
+  }
+
   headerHeight(): number {
     return this.headerHeightInternal;
   }
