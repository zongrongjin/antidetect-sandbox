diff --git a/front_end/panels/network/CacheRulesView.ts b/front_end/panels/network/CacheRulesView.ts
new file mode 100644
index 00000000..4760141d
--- /dev/null
+++ b/front_end/panels/network/CacheRulesView.ts
@@ -0,0 +1,362 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/* eslint-disable @devtools/no-imperative-dom-api */
+
+import * as SDK from '../../core/sdk/sdk.js';
+import * as UI from '../../ui/legacy/legacy.js';
+
+import cacheRulesViewStyles from './cacheRulesView.css.js';
+import type {NetworkLogView} from './NetworkLogView.js';
+
+const PATTERN_KEYS = [
+  'include',
+  'exclude',
+  'captures',
+  'callbacks',
+  'blocks',
+  'allowMiss',
+  'observe',
+] as const;
+
+type PatternKey = typeof PATTERN_KEYS[number];
+
+interface RowWidgets {
+  enabled: HTMLInputElement;
+  text: HTMLTextAreaElement;
+}
+
+interface ContextAgent {
+  invoke_getCacheState(params: object): Promise<{
+    dir?: string,
+    rules?: string,
+    map?: string,
+    getError?: () => string | undefined,
+  }>;
+  invoke_explainCache(params: object): Promise<{
+    results?: Array<{url?: string, method?: string, action?: string}>,
+    getError?: () => string | undefined,
+  }>;
+  invoke_setContextOverrides(params: object): Promise<{getError?: () => string | undefined}>;
+}
+
+const ACTION_CLASS: Record<string, string> = {
+  hit: 'zz-cache-hit',
+  html: 'zz-cache-html',
+  store: 'zz-cache-store',
+  block: 'zz-cache-block',
+  'allow-miss': 'zz-cache-allow-miss',
+  observe: 'zz-cache-observe',
+  capture: 'zz-cache-capture',
+  callback: 'zz-cache-callback',
+};
+
+export class CacheRulesView extends UI.Widget.VBox implements SDK.TargetManager.Observer {
+  readonly #logView: NetworkLogView;
+  readonly #rows = new Map<PatternKey, RowWidgets>();
+  readonly #ttl: HTMLInputElement;
+  readonly #maxEntry: HTMLInputElement;
+  readonly #status: HTMLInputElement;
+  readonly #error: HTMLElement;
+  readonly #dispatcher = {
+    cacheDecision: (params: {requestId?: string, url?: string, action?: string}): void => {
+      this.#onDecision(params.requestId || '', params.url || '', params.action || '');
+    },
+  };
+  #pendingById = new Map<string, string>();
+  #pendingByUrl = new Map<string, string>();
+  #listening = false;
+  #baseRules: Record<string, unknown> = {};
+
+  constructor(logView: NetworkLogView) {
+    super();
+    this.#logView = logView;
+    this.element.classList.add('zz-cache-rules');
+    this.registerRequiredCSS(cacheRulesViewStyles);
+
+    const title = this.element.createChild('div', 'zz-cache-title');
+    title.textContent = '缓存规则';
+
+    const legend = this.element.createChild('div', 'zz-cache-legend');
+    legend.appendChild(this.#swatch('zz-cache-hit', '命中'));
+    legend.appendChild(this.#swatch('zz-cache-store', '写入'));
+    legend.appendChild(this.#swatch('zz-cache-block', '拦截'));
+    legend.appendChild(this.#swatch('zz-cache-observe', '观察'));
+    legend.appendChild(this.#swatch('zz-cache-capture', '捕获'));
+    legend.appendChild(this.#swatch('zz-cache-allow-miss', '放行未命中'));
+
+    const hint = this.element.createChild('div', 'zz-cache-hint');
+    hint.textContent = '一行一个匹配，支持 * 和 ?。勾选才启用。未勾选的键会从规则里去掉。';
+
+    for (const key of PATTERN_KEYS) {
+      const row = this.element.createChild('label', 'zz-cache-row');
+      const head = row.createChild('div', 'zz-cache-row-head');
+      const box = head.createChild('input') as HTMLInputElement;
+      box.type = 'checkbox';
+      const name = head.createChild('span');
+      name.textContent = key;
+      const text = row.createChild('textarea') as HTMLTextAreaElement;
+      text.rows = 2;
+      text.spellcheck = false;
+      text.placeholder = key === 'include' ? '*  或  https://example.com/*' : 'https://example.com/path*';
+      this.#rows.set(key, {enabled: box, text});
+    }
+
+    this.#ttl = this.#numberRow('ttl 秒，0 为不过期');
+    this.#maxEntry = this.#numberRow('maxEntry 字节');
+    this.#status = this.#numberRow('cacheableStatus，逗号分隔');
+    this.#status.placeholder = '200';
+
+    this.#error = this.element.createChild('div', 'zz-cache-error');
+
+    const buttons = this.element.createChild('div', 'zz-cache-buttons');
+    const apply = buttons.createChild('button');
+    apply.textContent = '应用';
+    apply.addEventListener('click', () => void this.#apply());
+    const cancel = buttons.createChild('button');
+    cancel.textContent = '取消';
+    cancel.addEventListener('click', () => this.cancel());
+    this.#ensureListening();
+  }
+
+  override wasShown(): void {
+    super.wasShown();
+    this.#ensureListening();
+    void this.#load();
+  }
+
+  cancel(): void {
+    void this.#load();
+  }
+
+  targetAdded(target: SDK.Target.Target): void {
+    target.registerContextDispatcher(this.#dispatcher);
+  }
+
+  targetRemoved(target: SDK.Target.Target): void {
+    target.unregisterContextDispatcher(this.#dispatcher);
+  }
+
+  #ensureListening(): void {
+    if (this.#listening) {
+      return;
+    }
+    this.#listening = true;
+    const manager = SDK.TargetManager.TargetManager.instance();
+    manager.observeTargets(this);
+    manager.addModelListener(
+        SDK.NetworkManager.NetworkManager, SDK.NetworkManager.Events.RequestStarted, () => this.#flushPending(), this);
+    manager.addModelListener(
+        SDK.NetworkManager.NetworkManager, SDK.NetworkManager.Events.RequestFinished, () => this.#flushPending(), this);
+  }
+
+  #swatch(className: string, label: string): HTMLElement {
+    const item = document.createElement('span');
+    item.className = 'zz-cache-swatch ' + className;
+    item.textContent = label;
+    return item;
+  }
+
+  #numberRow(label: string): HTMLInputElement {
+    const row = this.element.createChild('label', 'zz-cache-number');
+    const span = row.createChild('span');
+    span.textContent = label;
+    const input = row.createChild('input') as HTMLInputElement;
+    input.type = 'text';
+    input.spellcheck = false;
+    return input;
+  }
+
+  #targets(): SDK.Target.Target[] {
+    return SDK.TargetManager.TargetManager.instance().targets();
+  }
+
+  #agent(): ContextAgent | null {
+    for (const target of this.#targets()) {
+      try {
+        const agent = target.contextAgent() as ContextAgent;
+        if (agent) {
+          return agent;
+        }
+      } catch {
+      }
+    }
+    return null;
+  }
+
+  async #load(): Promise<void> {
+    this.#error.textContent = '';
+    const agent = this.#agent();
+    if (!agent) {
+      this.#error.textContent = '当前目标没有 Context 域。';
+      return;
+    }
+    const state = await agent.invoke_getCacheState({});
+    const error = state.getError?.();
+    if (error) {
+      this.#error.textContent = error;
+      return;
+    }
+    let rules: Record<string, unknown> = {};
+    if (state.rules) {
+      try {
+        const parsed = JSON.parse(state.rules) as unknown;
+        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+          rules = parsed as Record<string, unknown>;
+        }
+      } catch {
+        this.#error.textContent = '现有 rules 不是 JSON 对象，打开后按空规则编辑。';
+      }
+    }
+    this.#baseRules = rules;
+    for (const key of PATTERN_KEYS) {
+      const row = this.#rows.get(key);
+      if (!row) {
+        continue;
+      }
+      const value = rules[key];
+      const list = Array.isArray(value) ? value.filter(item => typeof item === 'string') as string[] : null;
+      row.enabled.checked = !!list;
+      row.text.value = list ? list.join('\n') : '';
+    }
+    this.#ttl.value = rules['ttl'] === undefined || rules['ttl'] === null ? '' : String(rules['ttl']);
+    this.#maxEntry.value =
+        rules['maxEntry'] === undefined || rules['maxEntry'] === null ? '' : String(rules['maxEntry']);
+    const statuses = rules['cacheableStatus'];
+    this.#status.value = Array.isArray(statuses) ? statuses.join(',') : '';
+  }
+
+  #patterns(text: string): string[] {
+    return text.split(/\r?\n/).map(line => line.trim()).filter(line => line.length > 0);
+  }
+
+  async #apply(): Promise<void> {
+    this.#error.textContent = '';
+    const agent = this.#agent();
+    if (!agent) {
+      this.#error.textContent = '当前目标没有 Context 域。';
+      return;
+    }
+    const rules: Record<string, unknown> = {...this.#baseRules};
+    for (const key of PATTERN_KEYS) {
+      const row = this.#rows.get(key);
+      if (!row) {
+        continue;
+      }
+      if (!row.enabled.checked) {
+        delete rules[key];
+        continue;
+      }
+      const patterns = this.#patterns(row.text.value);
+      if (!patterns.length) {
+        this.#error.textContent = key + ' 已勾选，但没有匹配。';
+        return;
+      }
+      rules[key] = patterns;
+    }
+    const ttl = this.#ttl.value.trim();
+    rules['ttl'] = ttl === '' ? 0 : Number(ttl);
+    const maxEntry = this.#maxEntry.value.trim();
+    rules['maxEntry'] = maxEntry === '' ? 0 : Number(maxEntry);
+    if (!Number.isFinite(rules['ttl'] as number) || !Number.isFinite(rules['maxEntry'] as number)) {
+      this.#error.textContent = 'ttl 和 maxEntry 要是数字。';
+      return;
+    }
+    const statusText = this.#status.value.trim();
+    if (statusText) {
+      const statuses = statusText.split(',').map(part => Number(part.trim())).filter(part => Number.isFinite(part));
+      if (!statuses.length) {
+        this.#error.textContent = 'cacheableStatus 要是逗号分隔的状态码。';
+        return;
+      }
+      rules['cacheableStatus'] = statuses;
+    } else {
+      delete rules['cacheableStatus'];
+    }
+
+    const fresh = await agent.invoke_getCacheState({});
+    const freshError = fresh.getError?.();
+    if (freshError) {
+      this.#error.textContent = freshError;
+      return;
+    }
+    const set = await agent.invoke_setContextOverrides({
+      cache: {dir: fresh.dir || '', map: fresh.map || '', rules: JSON.stringify(rules)},
+    });
+    const setError = set.getError?.();
+    if (setError) {
+      this.#error.textContent = setError;
+      return;
+    }
+    this.#baseRules = rules;
+    await this.#explain(agent);
+  }
+
+  async #explain(agent: ContextAgent): Promise<void> {
+    const requests = this.#logView.zzCacheRequests();
+    const chunk = 200;
+    for (let i = 0; i < requests.length; i += chunk) {
+      const slice = requests.slice(i, i + chunk);
+      const response = await agent.invoke_explainCache({
+        requests: slice.map(request => ({url: request.url(), method: request.requestMethod || 'GET'})),
+      });
+      const error = response.getError?.();
+      if (error) {
+        this.#error.textContent = error;
+        return;
+      }
+      const results = response.results || [];
+      for (let n = 0; n < slice.length; ++n) {
+        const action = results[n]?.action || 'pass';
+        this.#paint(slice[n], action);
+      }
+    }
+  }
+
+  #onDecision(requestId: string, url: string, action: string): void {
+    if (!action) {
+      return;
+    }
+    const request = this.#logView.requestForZzCache(requestId, url);
+    if (!request) {
+      if (requestId) {
+        this.#pendingById.set(requestId, action);
+      }
+      if (url) {
+        this.#pendingByUrl.set(url, action);
+      }
+      return;
+    }
+    this.#paint(request, action);
+  }
+
+  #flushPending(): void {
+    if (!this.#pendingById.size && !this.#pendingByUrl.size) {
+      return;
+    }
+    for (const request of this.#logView.zzCacheRequests()) {
+      const byId = this.#pendingById.get(request.requestId());
+      const byUrl = this.#pendingByUrl.get(request.url());
+      const action = byId || byUrl;
+      if (!action) {
+        continue;
+      }
+      this.#paint(request, action);
+      this.#pendingById.delete(request.requestId());
+      if (byUrl && !byId) {
+        this.#pendingByUrl.delete(request.url());
+      }
+    }
+  }
+
+  #paint(request: SDK.NetworkRequest.NetworkRequest, action: string): void {
+    this.#logView.applyZzCacheAction(request, action);
+  }
+}
+
+export const ZZ_CACHE_ACTION_CLASSES = Object.values(ACTION_CLASS);
+
+export function zzCacheActionClass(action: string): string {
+  return ACTION_CLASS[action] || '';
+}
