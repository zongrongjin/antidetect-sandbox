+++ b/front_end/panels/network/cacheRulesView.css
@@ -0,0 +1,91 @@
+.zz-cache-rules {
+  padding: 8px 10px 12px;
+  overflow: auto;
+  font-size: 12px;
+}
+
+.zz-cache-title {
+  font-weight: 600;
+  margin-bottom: 6px;
+}
+
+.zz-cache-legend {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  margin-bottom: 8px;
+}
+
+.zz-cache-swatch {
+  border-radius: 3px;
+  padding: 1px 6px;
+}
+
+.zz-cache-hint {
+  color: var(--sys-color-on-surface-subtle);
+  margin-bottom: 8px;
+}
+
+.zz-cache-row,
+.zz-cache-number {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin-bottom: 8px;
+}
+
+.zz-cache-row-head {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-family: monospace;
+}
+
+.zz-cache-row textarea,
+.zz-cache-number input {
+  width: 100%;
+  box-sizing: border-box;
+  font-family: monospace;
+  font-size: 11px;
+}
+
+.zz-cache-error {
+  min-height: 16px;
+  color: var(--sys-color-error);
+  margin-bottom: 6px;
+}
+
+.zz-cache-buttons {
+  display: flex;
+  gap: 8px;
+}
+
+.zz-cache-buttons button {
+  padding: 4px 12px;
+}
+
+.zz-cache-hit,
+.zz-cache-html {
+  background: #d8f3dc;
+}
+
+.zz-cache-store {
+  background: #ffe8c2;
+}
+
+.zz-cache-block {
+  background: #ffd6d6;
+}
+
+.zz-cache-allow-miss {
+  background: #e6e6e6;
+}
+
+.zz-cache-observe {
+  background: #d6e8ff;
+}
+
+.zz-cache-capture,
+.zz-cache-callback {
+  background: #eadbff;
+}
diff --git a/front_end/panels/network/networkLogView.css b/front_end/panels/network/networkLogView.css
index ab38455d..6982901e 100644
--- a/front_end/panels/network/networkLogView.css
+++ b/front_end/panels/network/networkLogView.css
@@ -464,3 +464,36 @@ td.time-column {
     color: HighlightText;
   }
 }
+
+.network-log-grid.data-grid tr.zz-cache-hit,
+.network-log-grid.data-grid tr.zz-cache-html {
+  box-shadow: inset 3px 0 0 #137333;
+}
+.network-log-grid.data-grid tr.zz-cache-hit .name-column,
+.network-log-grid.data-grid tr.zz-cache-html .name-column {
+  color: #137333;
+  font-weight: 600;
+}
+.network-log-grid.data-grid tr.zz-cache-store {
+  box-shadow: inset 3px 0 0 #b06000;
+}
+.network-log-grid.data-grid tr.zz-cache-store .name-column {
+  color: #b06000;
+  font-weight: 600;
+}
+.network-log-grid.data-grid tr.zz-cache-block {
+  box-shadow: inset 3px 0 0 #c5221f;
+}
+.network-log-grid.data-grid tr.zz-cache-block .name-column {
+  color: #c5221f;
+}
+.network-log-grid.data-grid tr.zz-cache-allow-miss .name-column {
+  color: #5f6368;
+}
+.network-log-grid.data-grid tr.zz-cache-observe .name-column {
+  color: #1a73e8;
+}
+.network-log-grid.data-grid tr.zz-cache-capture .name-column,
+.network-log-grid.data-grid tr.zz-cache-callback .name-column {
+  color: #7b1fa2;
+}
